# Database Configuration
# Use PostgreSQL in production or SQLite for local development
DATABASE_URL=sqlite:///./identity.db
# PostgreSQL example:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/identity_db

# Security / JWT Configuration
JWT_SECRET_KEY=change_this_to_a_super_secret_random_key_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Initial Super Admin Seed Credentials
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=Admin@123456
INITIAL_ADMIN_NAME=Super Admin
INITIAL_COMPANY_NAME=Default Organization

# Service Port
PORT=8001
