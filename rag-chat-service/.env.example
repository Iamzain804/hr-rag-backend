# Service Port & URLs
PORT=8004
IDENTITY_SERVICE_URL=http://127.0.0.1:8001
INGESTION_SERVICE_URL=http://127.0.0.1:8003

# LLM Models (Groq only via LiteLLM Router)
DEFAULT_MODEL=groq/openai/gpt-oss-120b
FALLBACK_MODEL=groq/openai/gpt-oss-20b
CONFIDENCE_THRESHOLD=0.30

# Part A: Semantic Cache Settings
SEMANTIC_CACHE_ENABLED=true
SEMANTIC_CACHE_THRESHOLD=0.90
SEMANTIC_CACHE_TTL_SECONDS=86400
SEMANTIC_CACHE_DIR=./data/semantic_cache_db
SEMANTIC_CACHE_COLLECTION=hr_semantic_cache
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# Part B: Cross-Encoder Reranker Settings
RERANKER_ENABLED=true
RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2
INITIAL_RETRIEVAL_TOP_K=4
RERANK_TOP_K=3
RERANK_CONFIDENCE_THRESHOLD=0.25

# Part C: LangSmith Tracing & Privacy Settings
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=lsv2_pt_your_free_tier_api_key_here
LANGSMITH_PROJECT=hr-rag-assistant
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
TRACING_MASK_PII=true
TRACING_INCLUDE_RAW_ATTACHMENTS=false
