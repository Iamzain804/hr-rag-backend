# SMTP Configuration (Mailtrap sandbox by default)
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USERNAME=your_mailtrap_username
SMTP_PASSWORD=your_mailtrap_password
SMTP_FROM_EMAIL=no-reply@hr-rag-assistant.local
SMTP_FROM_NAME=HR Support & Security Team
SMTP_USE_TLS=True
SMTP_USE_SSL=False

# Retry Configuration
SMTP_MAX_RETRIES=2
SMTP_RETRY_BACKOFF_SECONDS=0.5

# Service Port
PORT=8002
